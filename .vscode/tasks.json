{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "frontend: instalar dependências",
      "type": "shell",
      "command": "npm install",
      "options": {
        "cwd": "${workspaceFolder}/finance-ia-/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "frontend: rodar dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/finance-ia-/frontend"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "aura-frontend"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
