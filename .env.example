# Aura Finance — variáveis de ambiente
# Copie para .env (na raiz) e preencha. O .env NUNCA é versionado.

PORT=3000

# Auth
# Use o "Legacy JWT Secret" do projeto Supabase (HS256) — é o que o requireAuth valida.
JWT_SECRET=

# Supabase (backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Supabase (client — expostas ao browser pelo Vite, prefixo VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IA
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos (opcional — defaults sensatos no server/src/env.ts)
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-flash

# Mercado (brapi.dev — opcional no plano gratuito)
BRAPI_TOKEN=
