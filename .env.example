# Aura Finance — variáveis de ambiente
# Copie para .env (na raiz) e preencha. O .env NUNCA é versionado.

PORT=3000

# Auth
# Use o "Legacy JWT Secret" do projeto Supabase (HS256) — é o que o requireAuth valida.
JWT_SECRET=

# Supabase (backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Supabase (client — expostas ao browser pelo Vite, prefixo VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IA
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Modelos (opcional — defaults sensatos no server/src/env.ts)
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-flash

# Mercado (brapi.dev — opcional no plano gratuito)
BRAPI_TOKEN=
# Mercado cripto (Binance, só leitura — sem chave). Troque se sua região bloquear
# api.binance.com (erro 451); alternativa pública: https://data-api.binance.vision
BINANCE_BASE_URL=https://api.binance.com

# Qual provedor de IA está ativo agora (gemini | claude). Gemini é grátis — default.
AI_PROVIDER=gemini

# Observabilidade e segurança (defaults servem para dev; ver server/src/env.ts)
LOG_LEVEL=info
# Nº de proxies reversos na frente do server (Render/Railway/etc = 1). 0 em localhost.
TRUST_PROXY=0
# Origens de CORS separadas por vírgula. Vazio = sem CORS (ok para monorepo same-origin).
CORS_ORIGINS=
# true derruba o rate limit (útil em teste de carga local). Nunca true em produção.
RATE_LIMIT_DISABLED=false
