# Aura Finance — variáveis de ambiente
# Copie para .env (na raiz) e preencha. O .env NUNCA é versionado.

PORT=3000

# Auth
# Só é necessário em projeto que ainda usa o "Legacy JWT Secret" (HS256). Projeto
# migrado para "JWT signing keys" assina em ES256/RS256 e o requireAuth valida
# pelo JWKS do próprio Supabase — nesse caso esta variável é opcional.
JWT_SECRET=

# Supabase (backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Supabase (client — expostas ao browser pelo Vite, prefixo VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IA
# Chat (Gemini, grátis) e análise de carteira (Groq/Llama, grátis — console.groq.com)
GEMINI_API_KEY=
GROQ_API_KEY=
# Provedor da análise: groq (default) | claude (exige ANTHROPIC_API_KEY)
ANALYZE_PROVIDER=groq
ANTHROPIC_API_KEY=
# Modelos (opcional — defaults sensatos no server/src/env.ts)
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Mercado BR (brapi.dev — opcional no plano gratuito)
BRAPI_TOKEN=
# Mercado cripto (Binance, só leitura — sem chave). Troque se sua região bloquear
# api.binance.com (erro 451); alternativa pública: https://data-api.binance.vision
BINANCE_BASE_URL=https://api.binance.com
# Mercado internacional (finnhub.io — plano gratuito, 60 req/min).
# Sem esta chave a aba Internacional responde 503 em vez de inventar número.
# O endpoint de candles (/stock/candle) é pago em boa parte das contas grátis:
# nesse caso o board mostra cotação e estatísticas, e o gráfico fica vazio.
FINNHUB_API_KEY=

# Observabilidade e segurança (defaults servem para dev; ver server/src/env.ts)
LOG_LEVEL=info
# Nº de proxies reversos na frente do server (Render/Railway/etc = 1). 0 em localhost.
TRUST_PROXY=0
# Origens de CORS separadas por vírgula. Vazio = sem CORS (ok para monorepo same-origin).
CORS_ORIGINS=
# true derruba o rate limit (útil em teste de carga local). Nunca true em produção.
RATE_LIMIT_DISABLED=false
